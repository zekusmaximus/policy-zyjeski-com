rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Viewpoints collection - read-only from client
    // Writes must go through Cloud Functions for rate limiting
    match /viewpoints/{viewpointId} {
      // Anyone can read viewpoint data
      allow read: if true;

      // Direct writes are blocked - must use Cloud Function
      // This prevents client-side manipulation and enables rate limiting
      allow write: if false;
    }

    // Rate limiting collection - tracks endorsements by IP/user
    match /endorsement_tracking/{trackingId} {
      // Only Cloud Functions can read/write tracking data
      allow read, write: if false;
    }

    // Default deny for all other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
